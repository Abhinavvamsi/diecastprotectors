generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Order {
  status         String   @default("Confirmed")
  id             String   @id @default(cuid())
  orderId        String   @unique
  userId         String?
  customer       String
  email          String
  phone          String
  address        String
  city           String
  pincode        String
  products       Json
  totalAmount    Int
  paymentId      String?

  // NEW
  reservationId  String?

  createdAt      DateTime @default(now())

  deliveryMethod String   @default("shipping")
  pickupLocation String?
}

model Product {
  id              String   @id @default(cuid())
  name            String   @unique
  description     String
  price           Int
  images          Json
  category        String
  stock           Int

  // NEW
  reservedStock   Int @default(0)

  quantityPricing Json?
  createdAt       DateTime @default(now())
  badge           String?

  brandId         String?
  brand           Brand? @relation(fields: [brandId], references: [id])

  reservationItems ReservationItem[]
}
model Coupon {
  id        String   @id @default(cuid())
  code      String   @unique
  type      String
  value     Int
  minOrder  Int      @default(0)
  active    Boolean  @default(true)
  usedBy    Json?
  createdAt DateTime @default(now())
}

model StoreSettings {
  id              String  @id @default(cuid())
  shippingCharge  Int
  shippingMessage String?
  pickupEnabled   Boolean @default(false)
  pickupLocation  String?
  maintenanceMode Boolean @default(false)
  superDealProductIds Json?
}

model Brand {
  id          String    @id @default(cuid())
  name        String    @unique
  logo        String?
  description String?
  createdAt   DateTime  @default(now())
  products    Product[]
}
model Banner {
  id         String   @id @default(cuid())

  title      String
  subtitle   String?

  images     Json

  buttonText String?
  buttonLink String?

  order      Int      @default(0)
  active     Boolean  @default(true)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}


model Admin {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String   @unique
  role      String   @default("ADMIN")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}


model Reservation {
  id        String   @id @default(cuid())

  userId    String

  status    ReservationStatus @default(ACTIVE)

  expiresAt DateTime

  createdAt DateTime @default(now())

  items ReservationItem[]
}

model ReservationItem {
  id String @id @default(cuid())

  reservationId String
  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  productId String
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  quantity Int

  @@index([productId])
}

enum ReservationStatus {
  ACTIVE
  COMPLETED
  EXPIRED
  CANCELLED
}
