generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Order {
  status String @default("Pending")

  id String @id @default(cuid())

  orderId String @unique

  userId String?

  customer String

  email String

  phone String

  address String

  city String

  pincode String

  products Json

  totalAmount Int

  paymentId String?

  createdAt DateTime @default(now())

  deliveryMethod String @default("shipping")

  pickupLocation String?
}

model Product {
  id String @id @default(cuid())

  name String

  description String

  price Int

  images Json

  category String

  stock Int

  quantityPricing Json?

  createdAt DateTime @default(now())

  badge String?

brandId String?

brand Brand? @relation(fields: [brandId], references: [id])
}
model Coupon {

  id        String   @id @default(cuid())

  code      String   @unique

  type      String

  value     Int

  minOrder  Int      @default(0)

  active    Boolean  @default(true)

  usedBy    Json?

  createdAt DateTime @default(now())

}

model StoreSettings {

  id String @id @default(cuid())

  shippingCharge Int

  shippingMessage String?

  pickupEnabled Boolean @default(false)

  pickupLocation String?
}


model Brand {
  id          String    @id @default(cuid())
  name        String    @unique
  logo        String?
  description String?

  products    Product[]

  createdAt   DateTime @default(now())
}